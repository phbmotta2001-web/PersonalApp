# Modelo das configurações do P-Bell.
#
# Como usar:
# 1. Copie este arquivo com o nome .env.local (na mesma pasta).
# 2. Preencha os valores no .env.local, NUNCA neste arquivo.
# 3. O .env.local fica fora do Git e não deve ser enviado a ninguém.
#
# Onde achar os valores: painel do Supabase > seu projeto > Project Settings.
#
# ATENÇÃO: o projeto de testes atual fica em us-west-2 (EUA), é PROVISÓRIO e só
# pode ter dados de exemplo. Ver docs/plano-perfil-e-privacidade.md.

# Endereço do projeto. Ex.: https://abcdefghijklmnop.supabase.co
# (Project Settings > Data API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave PÚBLICA do projeto: começa com "sb_publishable_".
# (Project Settings > API Keys > Publishable key)
# Em projetos mais antigos, aparece como "anon public" e começa com "eyJ".
# NÃO use aqui a "secret key" nem a "service_role": essas nunca vão para o site.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Notificações no celular (etapa 4b). Gere as três com:
#   node scripts/gerar-chaves-push.mjs
# (o script grava direto no .env.local, sem mostrar os valores). Depois copie as três
# para a Vercel (Settings > Environments > Production) e faça Redeploy.
# VAPID_PRIVATE_KEY e PUSH_SEGREDO são SECRETAS: nunca no código nem no chat.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SEGREDO=

# Marketplace (busca de personais, pedidos): base da Fase 2, DESLIGADO na Fase 1.
# Para testar o marketplace, troque para true e reinicie o npm run dev.
MARKETPLACE_ATIVO=false
